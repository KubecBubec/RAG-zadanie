        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#pocetIzieb"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Kraj -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Kraj">
