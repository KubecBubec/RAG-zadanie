    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Byt -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Byt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#RezidencnaNehnutelnost"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#nachadzaSaV"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Mesto"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#MestskaCast"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Dom"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Chata -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Chata">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Dom"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#RodinnyDom"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Dom -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Dom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#RezidencnaNehnutelnost"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#DvojizbovyByt -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#DvojizbovyByt">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Byt"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#pocetIzieb"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#JednoizbovyByt"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Garsonka -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Garsonka">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Byt"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#pocetIzieb"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Inzerat -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Inzerat">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#ponukaNehnutelnost"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#JednoizbovyByt -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#JednoizbovyByt">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Byt"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#pocetIzieb"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Kancelaria -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Kancelaria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#KomercnaNehnutelnost"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#ObchodnyPriestor"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Klient -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Klient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Osoba"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Makler"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#KomercnaNehnutelnost -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#KomercnaNehnutelnost">
