    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Mesto -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Mesto">
