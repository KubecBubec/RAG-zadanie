    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#KupnaZmluva -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#KupnaZmluva">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Zmluva"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#predmetZmluvy"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#NajomnaZmluva"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Kupujuci -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Kupujuci">
