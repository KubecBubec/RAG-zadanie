     -->

    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#jePonukanaV -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#jePonukanaV">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#ponukaNehnutelnost"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Inzerat"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#jeSucastou -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#jeSucastou">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#zahrna"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Lokalita"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Lokalita"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#jeVlastnenaKym -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#jeVlastnenaKym">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#vlastni"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Osoba"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#nachadzaSaV -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#nachadzaSaV">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#obsahujeNehnutelnost"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Lokalita"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#obsahujeNehnutelnost -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#obsahujeNehnutelnost">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Lokalita"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#ponukaNehnutelnost -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#ponukaNehnutelnost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Inzerat"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#predmetZmluvy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#predmetZmluvy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Zmluva"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#rezervujeObhliadku -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#rezervujeObhliadku">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Kupujuci"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Obhliadka"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#vlastni -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#vlastni">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Osoba"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#zahrna -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#zahrna">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Lokalita"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Lokalita"/>
    </owl:ObjectProperty>
    


