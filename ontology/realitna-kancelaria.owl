<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#"
     xml:base="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:realitna-kancelaria="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria">
        <rdfs:comment xml:lang="sk">Doménová ontológia (core domain ontology) pre realitnú kanceláriu: nehnuteľnosti, osoby, inzeráty, lokality, obhliadky a zmluvy.</rdfs:comment>
        <rdfs:label xml:lang="sk">Ontológia realitnej kancelárie</rdfs:label>
    </owl:Ontology>
    


