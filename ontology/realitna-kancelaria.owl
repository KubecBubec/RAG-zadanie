    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#MestskaCast -->

    <owl:Class rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#MestskaCast">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Lokalita"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#jeSucastou"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Mesto"/>
