    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#cena -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#cena">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Inzerat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#pocetIzieb -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#pocetIzieb">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#RezidencnaNehnutelnost"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#vymera -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#vymera">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kubo/ontologies/2026/9/realitna-kancelaria#Nehnutelnost"/>
